{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "layouts",
    "rules"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "layouts": {
      "type": "object",
      "additionalProperties": {
        "type": "object"
      }
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "footer": {
      "type": "object",
      "properties": {
        "component": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "$ref": "#/$defs/localizedText"
        },
        "copyright": {
          "$ref": "#/$defs/localizedText"
        }
      },
      "anyOf": [
        {
          "required": [
            "component"
          ]
        },
        {
          "required": [
            "message"
          ]
        },
        {
          "required": [
            "copyright"
          ]
        }
      ],
      "additionalProperties": false
    },
    "components": {
      "type": "object",
      "properties": {
        "sidebarNavigationBefore": {
          "type": [
            "string",
            "null"
          ]
        },
        "navigationAfter": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "hooks": {
      "type": "object",
      "properties": {
        "documentationNotices": {
          "type": "object",
          "properties": {
            "exploringTitle": {
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "type": "object",
                  "minProperties": 1,
                  "additionalProperties": {
                    "type": "string"
                  }
                }
              ]
            },
            "exploring": {
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "type": "object",
                  "minProperties": 1,
                  "additionalProperties": {
                    "type": "string"
                  }
                }
              ]
            },
            "validatedTitle": {
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "type": "object",
                  "minProperties": 1,
                  "additionalProperties": {
                    "type": "string"
                  }
                }
              ]
            },
            "validated": {
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "type": "object",
                  "minProperties": 1,
                  "additionalProperties": {
                    "type": "string"
                  }
                }
              ]
            },
            "fallbackTitle": {
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "type": "object",
                  "minProperties": 1,
                  "additionalProperties": {
                    "type": "string"
                  }
                }
              ]
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "localizedText": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "string"
          }
        }
      ]
    }
  }
}
