{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["creator", "fallbackImage"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "creator": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "email": {
            "type": "string",
            "format": "email"
          }
        },
        "additionalProperties": false
      }
    },
    "fallbackImage": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false,
  "description": "RSS feed creators and fallback image configuration. Page frontmatter images take precedence over the fallback."
}
