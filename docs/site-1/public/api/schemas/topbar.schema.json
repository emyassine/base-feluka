{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "guide": { "type": "string" },
          "collection": { "type": "string" },
          "text": {
            "oneOf": [
              { "type": "string" },
              { "type": "object", "additionalProperties": { "type": "string" } }
            ]
          },
          "link": {
            "oneOf": [
              { "type": "string", "minLength": 1 },
              {
                "type": "object",
                "minProperties": 1,
                "additionalProperties": { "type": "string", "minLength": 1 }
              }
            ]
          },
          "icon": { "type": "string" },
          "target": { "type": "string" },
          "rel": { "type": "string" },
          "activeMatch": { "type": "string" },
          "items": {
            "oneOf": [
              { "type": "array", "items": { "type": "object" } },
              {
                "type": "object",
                "required": ["source"],
                "properties": {
                  "source": { "enum": ["subguides", "subguides no-guide-index", "collections"] },
                  "pathPrefix": { "type": "string", "pattern": "^[A-Za-z0-9._~-]+(?:/[A-Za-z0-9._~-]+)*$" },
                  "depth": {
                    "oneOf": [
                      { "type": "string", "const": "all" },
                      { "type": "integer", "minimum": 1 },
                      {
                        "type": "array",
                        "items": { "type": "integer", "minimum": 1 },
                        "uniqueItems": true,
                        "minItems": 1
                      }
                    ],
                    "default": "all"
                  },
                  "icon": { "type": "boolean", "default": true }
                },
                "additionalProperties": false
              }
            ]
          }
        }
      }
    },
    "theme": {
      "enum": [
        "switch",
        "system",
        "light",
        "dark"
      ]
    }
  },
  "additionalProperties": false,
  "default": {
    "items": [],
    "theme": "switch",
    "$schema": "{schemaRef}"
  },
  "description": "SPMPST topbar concern configuration. The default value is the conforming-tool site scaffold."
}
