{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["components", "documentationNotices"],
  "properties": {
    "$schema": { "type": "string" },
    "components": {
      "type": "object",
      "properties": {
        "sidebarNavigationBefore": { "type": ["string", "null"] },
        "navigationAfter": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "documentationNotices": { "type": "object", "additionalProperties": true },
    "banner": {
      "type": ["object", "null"],
      "properties": {
        "enabled": { "type": "boolean", "default": true },
        "text": { "oneOf": [{ "type": "string" }, { "type": "object", "additionalProperties": { "type": "string" } }] },
        "icon": {
          "type": "object",
          "properties": {
            "name": { "type": "string", "pattern": "^@spmpst::icon::" },
            "position": { "enum": ["before", "after"], "default": "before" },
            "style": { "type": "object", "additionalProperties": { "type": ["string", "number"] } }
          },
          "required": ["name"],
          "additionalProperties": false
        },
        "action": {
          "type": "object",
          "properties": {
            "label": { "oneOf": [{ "type": "string" }, { "type": "object", "additionalProperties": { "type": "string" } }] },
            "href": { "type": "string", "minLength": 1 },
            "variant": { "enum": ["button", "link"], "default": "button" },
            "target": { "enum": ["_self", "_blank"] },
            "style": { "type": "object", "additionalProperties": { "type": ["string", "number"] } }
          },
          "required": ["label", "href"],
          "additionalProperties": false
        },
        "backgroundImage": { "type": "string", "minLength": 1 },
        "style": { "type": "object", "additionalProperties": { "type": ["string", "number"] } }
      },
      "required": ["text"],
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "default": { "$schema": "{schemaRef}", "components": {}, "documentationNotices": {} }
}
