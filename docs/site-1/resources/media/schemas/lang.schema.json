{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "languages",
    "fallbackLanguage",
    "selector"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "languages": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z]{2,3}(-[A-Z]{2})?$"
      }
    },
    "fallbackLanguage": {
      "type": "string"
    },
    "selector": {
      "type": "object",
      "properties": {
        "showSelector": {
          "type": "boolean"
        },
        "prefixDefaultLanguage": {
          "type": "boolean"
        },
        "showFlags": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "language": {
      "type": "object",
      "properties": {
        "label": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": {
                "type": "string"
              }
            }
          ]
        },
        "menuLabel": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": {
                "type": "string"
              }
            }
          ]
        },
        "fallbackNotice": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": {
                "type": "string"
              }
            }
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "localizedText": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "string"
          }
        }
      ]
    }
  }
}
