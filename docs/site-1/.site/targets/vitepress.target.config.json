{
  "outputDir": "../../docs-output/feluqa-docs",
  "project": {
    "components": "components",
    "hooks": "hooks"
  },
  "styles": [
    "components/home/docs-home.css",
    "components/components.css"
  ],
  "theme": {
    "slots": {
      "sidebar-nav-before": "BranchedSidebar",
      "nav-bar-content-after": "CollectionArticleSubnav"
    }
  },
  "markdown": {
    "lineNumbers": true,
    "image": {
      "lazyLoad": true
    }
  },
  "search": {
    "provider": "local",
    "miniSearch": {
      "fuzzy": 0.2,
      "prefix": true,
      "boost": {
        "title": 4,
        "text": 2,
        "titles": 1
      }
    },
    "excludePaths": []
  },
  "outline": {
    "level": "deep"
  },
  "$schema": "../schema/vitepress-target.schema.json"
}
