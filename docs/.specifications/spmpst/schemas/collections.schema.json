{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "collections"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "collections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "dir": {
            "type": "string"
          },
          "title": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              }
            ]
          },
          "description": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              }
            ]
          },
          "layout": {
            "enum": [
              "article",
              "doc"
            ]
          },
          "indexLayout": {
            "enum": [
              "list",
              "spotlight"
            ]
          },
          "categoryFile": {
            "type": "string",
            "pattern": "^spmpst\\.[A-Za-z0-9_-]+\\.json$"
          }
        },
        "additionalProperties": false
      }
    },
    "emptyCollection": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "string"
          }
        }
      ]
    }
  },
  "additionalProperties": false,
  "$defs": {
    "localizedText": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "string"
          }
        }
      ]
    }
  },
  "default": {
    "collections": [],
    "$schema": "../public/media/schemas/collections.schema.json",
    "emptyCollection": {
      "en": "No content published yet."
    }
  },
  "description": "SPMPST collections concern configuration. The default value is the conforming-tool site scaffold."
}
