{
  "site": {
    "name": "Feluqa",
    "description": "Feluqa Documentation"
  },
  "fonts": {
    "body": {
      "family": "Manrope",
      "src": ".art/fonts/manrope-latin.woff2",
      "weight": "200 800"
    }
  },
  "guidesPath": ".",
  "indexPath": "index.en.md",
  "outputDir": "../build",
  "subguides": [
    {
      "path": "feluqa.rs",
      "label": "Feluqa"
    },
    {
      "path": "x-agents",
      "label": "AI agent guides"
    }
  ],
  "languages": [
    "en"
  ],
  "markdown": {
    "lineNumbers": true,
    "image": {
      "lazyLoad": true
    }
  },
  "search": {
    "labels": {
      "root": {
        "buttonText": "Search",
        "buttonAriaLabel": "Search documentation",
        "displayDetails": "Display detailed list",
        "resetButtonTitle": "Reset search",
        "backButtonTitle": "Close search",
        "noResultsText": "No results",
        "selectText": "Select",
        "selectKeyAriaLabel": "Enter",
        "navigateText": "Navigate",
        "navigateUpKeyAriaLabel": "Arrow up",
        "navigateDownKeyAriaLabel": "Arrow down",
        "closeText": "Close",
        "closeKeyAriaLabel": "Escape"
      }
    },
    "provider": "local",
    "miniSearch": {
      "fuzzy": 0.2,
      "prefix": true,
      "boost": {
        "title": 4,
        "text": 2,
        "titles": 1
      }
    },
    "excludePaths": []
  },
  "outline": {
    "labels": {
      "en": "On this page"
    },
    "level": "deep"
  },
  "footer": {
    "en": {
      "message": "Feluqa documentation",
      "copyright": "Copyright © <a href=\"https://numerimondes.com\">Numerimondes</a>"
    }
  }
}
