{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "fonts": {
      "type": "object"
    },
    "logo": {
      "type": "object",
      "properties": {
        "light": { "type": "string" },
        "mini-light": { "type": "string" },
        "dark": { "type": "string" },
        "mini-dark": { "type": "string" },
        "alt": { "type": "string" },
        "width": { "type": "string" },
        "height": { "type": "string" },
        "extraStyle": { "type": "string" }
      },
      "additionalProperties": false
    },
    "ogImages": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      ]
    },
    "styles": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "mermaid": {
      "type": "object"
    }
  },
  "additionalProperties": false,
  "default": {
    "styles": [],
    "mermaid": {
      "flowchartPalette": [
        {
          "fill": "#e8eaf0",
          "text": "#20222a",
          "stroke": "#7451d5"
        }
      ],
      "nodeBorderWidth": "1.5px",
      "darkMessageTextColor": "#f1f3fc"
    },
    "$schema": "../public/api/beta/schemas/spmpst-standard/appearance.schema.json"
  },
  "description": "SPMPST appearance concern configuration. The default value is the conforming-tool site scaffold."
}
