{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["content"],
  "properties": {
    "$schema": { "type": "string" },
    "component": { "type": ["string", "null"] },
    "content": {
      "type": "object",
      "properties": {
        "title": { "$ref": "#/$defs/localizedText" },
        "description": { "$ref": "#/$defs/localizedText" },
        "actionLabel": { "$ref": "#/$defs/localizedText" },
        "actionHref": { "type": "string", "minLength": 1 },
        "navigation": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "href"],
            "properties": {
              "name": { "$ref": "#/$defs/localizedText" },
              "href": { "type": "string", "minLength": 1 },
              "external": { "type": "boolean" }
            },
            "additionalProperties": false
          }
        },
        "subNavigation": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "href"],
            "properties": {
              "name": { "$ref": "#/$defs/localizedText" },
              "href": { "type": "string", "minLength": 1 },
              "external": { "type": "boolean" }
            },
            "additionalProperties": false
          }
        },
        "logoImg": { "type": "string" },
        "logoAlt": { "$ref": "#/$defs/localizedText" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "localizedText": {
      "oneOf": [
        { "type": "string" },
        { "type": "object", "minProperties": 1, "additionalProperties": { "type": "string" } }
      ]
    }
  },
  "default": {
    "$schema": "{schemaRef}",
    "content": {}
  }
}
