{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "guide": { "type": "string" },
          "collection": { "type": "string" },
          "text": {
            "oneOf": [
              { "type": "string" },
              { "type": "object", "additionalProperties": { "type": "string" } }
            ]
          },
          "link": {
            "oneOf": [
              { "type": "string", "minLength": 1 },
              {
                "type": "object",
                "minProperties": 1,
                "additionalProperties": { "type": "string", "minLength": 1 }
              }
            ]
          },
          "icon": { "type": "string" },
          "hideIcon": { "type": "boolean", "default": false },
          "menuTitle": {
            "oneOf": [
              { "type": "string" },
              { "type": "object", "additionalProperties": { "type": "string" } }
            ]
          },
          "menuTemplate": {
            "type": "array",
            "minItems": 1,
            "maxItems": 3,
            "items": [
              { "type": "string", "minLength": 1 },
              { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
              {
                "type": "object",
                "properties": {
                  "maxItems": { "type": "integer", "minimum": 1 },
                  "cardHeight": { "type": "integer", "minimum": 1 },
                  "composition": {
                    "type": "object",
                    "required": ["columns"],
                    "properties": {
                      "columns": {
                        "type": "array",
                        "minItems": 1,
                        "items": {
                          "oneOf": [
                            {
                              "type": "array",
                              "minItems": 1,
                              "items": { "oneOf": [{ "type": "integer", "minimum": 0 }, { "const": "more" }] }
                            },
                            {
                              "type": "object",
                              "required": ["items"],
                              "properties": {
                                "width": { "type": "string", "minLength": 1 },
                                "gap": { "type": "number", "minimum": 0 },
                                "items": {
                                  "type": "array",
                                  "minItems": 1,
                                  "items": { "oneOf": [{ "type": "integer", "minimum": 0 }, { "const": "more" }] }
                                }
                              },
                              "additionalProperties": false
                            }
                          ]
                        }
                      }
                    },
                    "additionalProperties": false
                  }
                }
              }
            ]
          },
          "target": { "type": "string" },
          "rel": { "type": "string" },
          "activeMatch": { "type": "string" },
          "items": {
            "oneOf": [
              { "type": "array", "items": { "type": "object" } },
              {
                "type": "object",
                "required": ["source"],
                "properties": {
                  "source": { "enum": ["subguides", "subguides no-guide-index", "collections"] },
                  "collections": {
                    "type": "object",
                    "properties": {
                      "order": {
                        "type": "array",
                        "items": {
                          "oneOf": [
                            { "type": "string", "minLength": 1 },
                            { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
                          ]
                        }
                      },
                      "pathPrefix": { "type": "string", "pattern": "^[A-Za-z0-9._~-]+(?:/[A-Za-z0-9._~-]+)*$" },
                      "hideChildren": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
                      "showIconFromParents": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 }, "default": [] },
                      "showParentsName": { "type": "boolean", "default": true },
                      "separateBetweenCollections": { "type": "boolean", "default": false }
                    },
                    "additionalProperties": false
                  },
                  "hideIcon": { "type": "boolean", "default": false },
                  "depth": {
                    "oneOf": [
                      { "type": "string", "const": "all" },
                      { "type": "integer", "minimum": 1 },
                      {
                        "type": "array",
                        "items": { "type": "integer", "minimum": 1 },
                        "uniqueItems": true,
                        "minItems": 1
                      }
                    ],
                    "default": "all"
                  },
                  "icon": { "type": "boolean", "default": true },
                  "includeArticles": { "type": "boolean", "default": false }
                },
                "allOf": [
                  {
                    "if": { "properties": { "source": { "const": "collections" } }, "required": ["source"] },
                    "then": { "required": ["collections"] },
                    "else": { "not": { "required": ["collections"] } }
                  }
                ],
                "additionalProperties": false
              }
            ]
          }
        }
      }
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["label", "link"],
        "properties": {
          "label": {
            "oneOf": [
              { "type": "string", "minLength": 1 },
              { "type": "object", "additionalProperties": { "type": "string", "minLength": 1 } }
            ]
          },
          "link": {
            "oneOf": [
              { "type": "string", "minLength": 1 },
              { "type": "object", "minProperties": 1, "additionalProperties": { "type": "string", "minLength": 1 } }
            ]
          },
          "color": { "enum": ["primary", "gray", "info", "success", "warning", "danger", "dark", "secondary"] },
          "size": { "enum": ["xs", "sm", "md", "lg", "xl"] },
          "outlined": { "type": "boolean" },
          "external": { "type": "boolean" }
        },
        "additionalProperties": false
      }
    },
    "theme": {
      "enum": [
        "switch",
        "system",
        "light",
        "dark"
      ]
    }
  },
  "additionalProperties": false,
  "default": {
    "items": [],
    "theme": "switch",
    "$schema": "{schemaRef}"
  },
  "description": "SPMPST topbar concern configuration. The default value is the conforming-tool site scaffold."
}
