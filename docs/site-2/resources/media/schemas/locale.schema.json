{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SPMPST localized strings",
  "type": "object",
  "required": ["strings"],
  "properties": {
    "$schema": { "type": "string" },
    "strings": { "$ref": "#/$defs/node" }
  },
  "additionalProperties": false,
  "$defs": {
    "node": {
      "oneOf": [
        { "type": "string" },
        { "type": "array", "items": { "$ref": "#/$defs/node" } },
        {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "$ref": "#/$defs/node" }
        }
      ]
    }
  }
}
