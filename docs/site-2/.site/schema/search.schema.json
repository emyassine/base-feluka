{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["provider"],
  "properties": {
    "$schema": { "type": "string" },
    "provider": { "type": "string", "minLength": 1 },
    "miniSearch": {
      "type": "object",
      "properties": {
        "fuzzy": { "type": "number", "minimum": 0, "maximum": 1 },
        "prefix": { "type": "boolean" },
        "boost": { "type": "object", "additionalProperties": { "type": "number" } }
      },
      "additionalProperties": false
    },
    "excludePaths": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": false
}
