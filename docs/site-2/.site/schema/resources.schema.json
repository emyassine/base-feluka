{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "icons",
    "flags"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "icons": {
      "type": "object",
      "required": [
        "sources"
      ],
      "properties": {
        "sources": {
          "$ref": "#/$defs/sharedSources"
        },
        "sites": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      },
      "additionalProperties": false
    },
    "flags": {
      "type": "object",
      "required": [
        "sources"
      ],
      "properties": {
        "sources": {
          "$ref": "#/$defs/sharedSources"
        }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "sharedSources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "uri"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "uri": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
