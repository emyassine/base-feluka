{
  "$schema": "../public/api/beta/schemas/spmpst-standard/topbar.schema.json",
  "theme": "switch",
  "items": [
    {
      "type": "menu",
      "label": { "en": "Services" },
      "groups": [
        {
          "label": { "en": "Marketplace" },
          "showLabel": false,
          "entries": [
            { "type": "link", "label": { "en": "Explore services" }, "href": "/services/marketplace", "icon": "store" }
          ]
        },
        {
          "label": { "en": "Pricing" },
          "showLabel": false,
          "entries": [
            { "type": "link", "label": { "en": "Understanding Pricing" }, "href": "/services/pricing", "icon": "scale" }
          ]
        },
        {
          "label": { "en": "Capabilities" },
          "showLabel": true,
          "entries": [
            { "type": "collection", "id": "capabilities", "children": true }
          ]
        },
        {
          "label": { "en": "Contact" },
          "showLabel": true,
          "entries": [
            { "type": "link", "label": { "en": "Contact Numerimondes" }, "href": "/company/contact/", "icon": "message-circle" }
          ]
        }
      ]
    },
    {
      "type": "menu",
      "label": { "en": "Opportunities" },
      "groups": [
        {
          "label": { "en": "Opportunities" },
          "showLabel": false,
          "entries": [
            { "type": "guide", "path": "opportunities", "children": { "source": "subguides no-guide-index", "icon": true } }
          ]
        }
      ]
    },
    {
      "type": "menu",
      "label": { "en": "Company" },
      "groups": [
        {
          "label": { "en": "Company" },
          "showLabel": false,
          "entries": [
            { "type": "guide", "path": "company", "children": { "source": "subguides no-guide-index", "icon": true } }
          ]
        }
      ]
    },
    {
      "type": "menu",
      "label": { "en": "Resources" },
      "groups": [
        {
          "label": { "en": "Resources" },
          "showLabel": false,
          "entries": [
            {
              "type": "collections",
              "children": {
                "source": "collections",
                "depth": "all",
                "icon": true,
                "collections": {
                  "pathPrefix": "001-legal",
                  "order": ["legal"],
                  "showIconFromParents": ["legal"],
                  "showParentsName": false
                }
              }
            }
          ]
        }
      ]
    }
  ],
  "actions": [
    {
      "label": { "en": "Account access" },
      "link": "/account/",
      "color": "primary",
      "size": "sm",
      "mobile": { "color": "gray", "icon": "users", "tooltip": "Accounts" },
      "icon": "users-round"
    }
  ]
}
