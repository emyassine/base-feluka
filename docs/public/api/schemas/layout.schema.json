{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["layouts", "rules"],
  "properties": {
    "$schema": { "type": "string" },
    "layouts": { "type": "object", "additionalProperties": { "type": "object" } },
    "rules": { "type": "array", "items": { "type": "object" } }
  },
  "additionalProperties": false,
  "default": { "$schema": "{schemaRef}", "layouts": {}, "rules": [] },
  "description": "SPMPST layout concern configuration. Layouts and rules are reusable page composition declarations."
}
