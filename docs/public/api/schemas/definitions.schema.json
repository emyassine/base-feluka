{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "site",
    "subguides",
    "iconFallback"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "site": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "floatingSubnav": {
          "$ref": "#/$defs/floatingSubnav"
        }
      },
      "additionalProperties": false
    },
    "iconFallback": {
      "type": "string"
    },
    "subguides": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "uri"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "labels": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "uri": {
            "type": "object",
            "required": [
              "base"
            ],
            "properties": {
              "base": {
                "type": "string"
              },
              "index": {
                "type": "string"
              },
              "entry": {
                "type": "string"
              }
            },
            "additionalProperties": false
          },
          "floatingSubnav": {
            "$ref": "#/$defs/floatingSubnav"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "floatingSubnav": {
      "type": "object",
      "properties": {
        "layouts": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "include": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^/(?:[A-Za-z0-9._~-]+(?:/[A-Za-z0-9._~-]+)*)?/?$" }
        },
        "exclude": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^/(?:[A-Za-z0-9._~-]+(?:/[A-Za-z0-9._~-]+)*)?/?$" }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "default": {
    "site": {
      "name": "{siteName}",
      "description": "Documentation for {siteName}."
    },
    "subguides": [
      {
        "path": "{guidePath}",
        "label": "Guides",
        "labels": {
          "en": "Guides"
        },
        "uri": {
          "base": "/"
        }
      }
    ],
    "iconFallback": "circle-help",
    "$schema": "../public/media/schemas/definitions.schema.json"
  },
  "description": "SPMPST definitions concern configuration. The default value is the conforming-tool site scaffold."
}
