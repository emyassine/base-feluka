{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "inlineLogo": {
      "type": "boolean"
    },
    "lastUpdated": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "label": {
          "type": "object",
          "required": ["en", "fr"],
          "properties": {
            "en": { "type": "string", "minLength": 1 },
            "fr": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
