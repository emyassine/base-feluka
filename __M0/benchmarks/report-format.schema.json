{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://feluka.dev/schemas/benchmark-report-v1.json",
  "title": "Feluka benchmark presentation data",
  "type": "object",
  "required": ["schema_version", "benchmark_id", "title", "status", "summary_cards", "sections"],
  "properties": {
    "schema_version": {"const": 1},
    "benchmark_id": {"type": "string"},
    "title": {"type": "string"},
    "status": {"enum": ["passed", "failed", "informational", "incomplete"]},
    "generated_at": {"type": "string"},
    "summary": {"type": "string"},
    "decision": {
      "type": ["object", "null"],
      "required": ["title", "detail"],
      "properties": {
        "title": {"type": "string"},
        "detail": {"type": "string"},
        "tone": {"enum": ["success", "warning", "danger", "primary"]}
      }
    },
    "summary_cards": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["label", "value"],
        "properties": {
          "label": {"type": "string"},
          "value": {"type": ["string", "number"]},
          "note": {"type": "string"}
        }
      }
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["title", "type"],
        "properties": {
          "title": {"type": "string"},
          "type": {"enum": ["comparison", "table", "checks", "text"]},
          "description": {"type": "string"},
          "metrics": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {"type": "string"},
                "label": {"type": "string"},
                "unit": {"type": "string"},
                "weight": {"type": "number", "minimum": 0, "maximum": 100},
                "weight_explanation": {"type": "string", "description": "Rationale or preregistration context shown in an accessible tooltip on the weight."},
                "better": {"enum": ["lower", "higher"]},
                "values": {"type": "object", "additionalProperties": {"type": ["number", "string", "null"]}},
                "explanation": {"type": "string", "description": "Detailed scoring method shown in a keyboard-accessible tooltip on the metric name."},
                "decimals": {"type": "integer", "minimum": 0, "maximum": 8}
              }
            }
          },
          "columns": {"type": "array", "items": {"type": "string"}},
          "rows": {"type": "array", "items": {"type": "array"}},
          "text": {"type": "string"}
        }
      }
    },
    "limitations": {"type": "array", "items": {"type": "string"}}
  }
}
