{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/grammar.schema.json",
  "name": "feluqa_view",
  "rules": {
    "source_file": {
      "type": "REPEAT",
      "content": {
        "type": "SYMBOL",
        "name": "_node"
      }
    },
    "_node": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "text"
        },
        {
          "type": "SYMBOL",
          "name": "escaped_output"
        },
        {
          "type": "SYMBOL",
          "name": "raw_output"
        },
        {
          "type": "SYMBOL",
          "name": "template_comment"
        },
        {
          "type": "SYMBOL",
          "name": "rust_block"
        },
        {
          "type": "SYMBOL",
          "name": "if_block"
        },
        {
          "type": "SYMBOL",
          "name": "foreach_block"
        },
        {
          "type": "SYMBOL",
          "name": "include_directive"
        },
        {
          "type": "SYMBOL",
          "name": "extends_directive"
        },
        {
          "type": "SYMBOL",
          "name": "section_block"
        },
        {
          "type": "SYMBOL",
          "name": "yield_directive"
        },
        {
          "type": "SYMBOL",
          "name": "component"
        },
        {
          "type": "SYMBOL",
          "name": "html_tag"
        },
        {
          "type": "SYMBOL",
          "name": "escaped_at"
        }
      ]
    },
    "text": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": -1,
        "content": {
          "type": "PATTERN",
          "value": "[^<@{}]+"
        }
      }
    },
    "escaped_at": {
      "type": "STRING",
      "value": "@@"
    },
    "escaped_output": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "{{"
        },
        {
          "type": "ALIAS",
          "content": {
            "type": "SYMBOL",
            "name": "_rust_expression"
          },
          "named": true,
          "value": "rust_expression"
        },
        {
          "type": "STRING",
          "value": "}}"
        }
      ]
    },
    "raw_output": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "{!!"
        },
        {
          "type": "ALIAS",
          "content": {
            "type": "SYMBOL",
            "name": "_rust_raw_expression"
          },
          "named": true,
          "value": "rust_expression"
        },
        {
          "type": "STRING",
          "value": "!!}"
        }
      ]
    },
    "template_comment": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "{{--"
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "CHOICE",
            "members": [
              {
                "type": "PATTERN",
                "value": "[^-]"
              },
              {
                "type": "SEQ",
                "members": [
                  {
                    "type": "STRING",
                    "value": "-"
                  },
                  {
                    "type": "PATTERN",
                    "value": "[^-]"
                  }
                ]
              }
            ]
          }
        },
        {
          "type": "STRING",
          "value": "--}}"
        }
      ]
    },
    "rust_block": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "@rs"
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "ALIAS",
              "content": {
                "type": "SYMBOL",
                "name": "_rust_block_body"
              },
              "named": true,
              "value": "rust_block_body"
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "STRING",
          "value": "@endrs"
        }
      ]
    },
    "if_block": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "@if"
        },
        {
          "type": "STRING",
          "value": "("
        },
        {
          "type": "ALIAS",
          "content": {
            "type": "SYMBOL",
            "name": "_rust_condition"
          },
          "named": true,
          "value": "rust_condition"
        },
        {
          "type": "STRING",
          "value": ")"
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SYMBOL",
            "name": "_node"
          }
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SEQ",
            "members": [
              {
                "type": "STRING",
                "value": "@elseif"
              },
              {
                "type": "STRING",
                "value": "("
              },
              {
                "type": "ALIAS",
                "content": {
                  "type": "SYMBOL",
                  "name": "_rust_condition"
                },
                "named": true,
                "value": "rust_condition"
              },
              {
                "type": "STRING",
                "value": ")"
              },
              {
                "type": "REPEAT",
                "content": {
                  "type": "SYMBOL",
                  "name": "_node"
                }
              }
            ]
          }
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SEQ",
              "members": [
                {
                  "type": "STRING",
                  "value": "@else"
                },
                {
                  "type": "REPEAT",
                  "content": {
                    "type": "SYMBOL",
                    "name": "_node"
                  }
                }
              ]
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "STRING",
          "value": "@endif"
        }
      ]
    },
    "foreach_block": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "@foreach"
        },
        {
          "type": "STRING",
          "value": "("
        },
        {
          "type": "ALIAS",
          "content": {
            "type": "SYMBOL",
            "name": "_rust_condition"
          },
          "named": true,
          "value": "rust_loop_header"
        },
        {
          "type": "STRING",
          "value": ")"
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SYMBOL",
            "name": "_node"
          }
        },
        {
          "type": "STRING",
          "value": "@endforeach"
        }
      ]
    },
    "include_directive": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "@include"
        },
        {
          "type": "STRING",
          "value": "("
        },
        {
          "type": "ALIAS",
          "content": {
            "type": "SYMBOL",
            "name": "_rust_condition"
          },
          "named": true,
          "value": "rust_arguments"
        },
        {
          "type": "STRING",
          "value": ")"
        }
      ]
    },
    "extends_directive": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "@extends"
        },
        {
          "type": "STRING",
          "value": "("
        },
        {
          "type": "SYMBOL",
          "name": "string_literal"
        },
        {
          "type": "STRING",
          "value": ")"
        }
      ]
    },
    "section_block": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "@section"
        },
        {
          "type": "STRING",
          "value": "("
        },
        {
          "type": "SYMBOL",
          "name": "string_literal"
        },
        {
          "type": "STRING",
          "value": ")"
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SYMBOL",
            "name": "_node"
          }
        },
        {
          "type": "STRING",
          "value": "@endsection"
        }
      ]
    },
    "yield_directive": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "@yield"
        },
        {
          "type": "STRING",
          "value": "("
        },
        {
          "type": "SYMBOL",
          "name": "string_literal"
        },
        {
          "type": "STRING",
          "value": ")"
        }
      ]
    },
    "component": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SEQ",
          "members": [
            {
              "type": "STRING",
              "value": "<x-"
            },
            {
              "type": "SYMBOL",
              "name": "component_name"
            },
            {
              "type": "REPEAT",
              "content": {
                "type": "SYMBOL",
                "name": "attribute"
              }
            },
            {
              "type": "STRING",
              "value": "/>"
            }
          ]
        },
        {
          "type": "SEQ",
          "members": [
            {
              "type": "STRING",
              "value": "<x-"
            },
            {
              "type": "SYMBOL",
              "name": "component_name"
            },
            {
              "type": "REPEAT",
              "content": {
                "type": "SYMBOL",
                "name": "attribute"
              }
            },
            {
              "type": "STRING",
              "value": ">"
            },
            {
              "type": "REPEAT",
              "content": {
                "type": "SYMBOL",
                "name": "_node"
              }
            },
            {
              "type": "STRING",
              "value": "</x-"
            },
            {
              "type": "SYMBOL",
              "name": "component_name"
            },
            {
              "type": "STRING",
              "value": ">"
            }
          ]
        }
      ]
    },
    "component_name": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": 2,
        "content": {
          "type": "PATTERN",
          "value": "[A-Za-z_][A-Za-z0-9_]*(::[A-Za-z_][A-Za-z0-9_-]*)*"
        }
      }
    },
    "html_tag": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SEQ",
          "members": [
            {
              "type": "STRING",
              "value": "<"
            },
            {
              "type": "SYMBOL",
              "name": "tag_name"
            },
            {
              "type": "REPEAT",
              "content": {
                "type": "SYMBOL",
                "name": "attribute"
              }
            },
            {
              "type": "STRING",
              "value": "/>"
            }
          ]
        },
        {
          "type": "SEQ",
          "members": [
            {
              "type": "STRING",
              "value": "<"
            },
            {
              "type": "SYMBOL",
              "name": "tag_name"
            },
            {
              "type": "REPEAT",
              "content": {
                "type": "SYMBOL",
                "name": "attribute"
              }
            },
            {
              "type": "STRING",
              "value": ">"
            }
          ]
        },
        {
          "type": "SEQ",
          "members": [
            {
              "type": "STRING",
              "value": "</"
            },
            {
              "type": "SYMBOL",
              "name": "tag_name"
            },
            {
              "type": "STRING",
              "value": ">"
            }
          ]
        }
      ]
    },
    "tag_name": {
      "type": "TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "[A-Za-z][A-Za-z0-9:-]*"
      }
    },
    "attribute": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SEQ",
          "members": [
            {
              "type": "STRING",
              "value": ":"
            },
            {
              "type": "SYMBOL",
              "name": "attribute_name"
            },
            {
              "type": "STRING",
              "value": "="
            },
            {
              "type": "ALIAS",
              "content": {
                "type": "SEQ",
                "members": [
                  {
                    "type": "STRING",
                    "value": "\""
                  },
                  {
                    "type": "ALIAS",
                    "content": {
                      "type": "SYMBOL",
                      "name": "_rust_attribute_expression"
                    },
                    "named": true,
                    "value": "rust_expression"
                  },
                  {
                    "type": "STRING",
                    "value": "\""
                  }
                ]
              },
              "named": true,
              "value": "bound_value"
            }
          ]
        },
        {
          "type": "SEQ",
          "members": [
            {
              "type": "SYMBOL",
              "name": "attribute_name"
            },
            {
              "type": "STRING",
              "value": "="
            },
            {
              "type": "SYMBOL",
              "name": "quoted_value"
            }
          ]
        },
        {
          "type": "SYMBOL",
          "name": "attribute_name"
        }
      ]
    },
    "attribute_name": {
      "type": "TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "[A-Za-z_][A-Za-z0-9_:.-]*"
      }
    },
    "quoted_value": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SEQ",
          "members": [
            {
              "type": "STRING",
              "value": "\""
            },
            {
              "type": "REPEAT",
              "content": {
                "type": "CHOICE",
                "members": [
                  {
                    "type": "PATTERN",
                    "value": "[^\"\\\\]"
                  },
                  {
                    "type": "PATTERN",
                    "value": "\\\\."
                  }
                ]
              }
            },
            {
              "type": "STRING",
              "value": "\""
            }
          ]
        },
        {
          "type": "SEQ",
          "members": [
            {
              "type": "STRING",
              "value": "'"
            },
            {
              "type": "REPEAT",
              "content": {
                "type": "CHOICE",
                "members": [
                  {
                    "type": "PATTERN",
                    "value": "[^'\\\\]"
                  },
                  {
                    "type": "PATTERN",
                    "value": "\\\\."
                  }
                ]
              }
            },
            {
              "type": "STRING",
              "value": "'"
            }
          ]
        }
      ]
    },
    "string_literal": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SEQ",
          "members": [
            {
              "type": "STRING",
              "value": "\""
            },
            {
              "type": "REPEAT",
              "content": {
                "type": "CHOICE",
                "members": [
                  {
                    "type": "PATTERN",
                    "value": "[^\"\\\\]"
                  },
                  {
                    "type": "PATTERN",
                    "value": "\\\\."
                  }
                ]
              }
            },
            {
              "type": "STRING",
              "value": "\""
            }
          ]
        },
        {
          "type": "SEQ",
          "members": [
            {
              "type": "STRING",
              "value": "'"
            },
            {
              "type": "REPEAT",
              "content": {
                "type": "CHOICE",
                "members": [
                  {
                    "type": "PATTERN",
                    "value": "[^'\\\\]"
                  },
                  {
                    "type": "PATTERN",
                    "value": "\\\\."
                  }
                ]
              }
            },
            {
              "type": "STRING",
              "value": "'"
            }
          ]
        }
      ]
    }
  },
  "extras": [
    {
      "type": "PATTERN",
      "value": "[\\t\\r\\n ]+"
    }
  ],
  "conflicts": [],
  "precedences": [],
  "externals": [
    {
      "type": "SYMBOL",
      "name": "_rust_block_body"
    },
    {
      "type": "SYMBOL",
      "name": "_rust_expression"
