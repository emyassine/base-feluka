#![no_implicit_prelude]

use crate::axum::http::StatusCode;
use crate::axum::response::{Html, IntoResponse, Response};
use crate::views;
use crate::std::result::Result;
use crate::std::result::Result::{Err, Ok};
use crate::std::string::String;

pub(crate) async fn home() -> Response {
    match views::home("@@NAME@@") {
        Ok(html) => Html(html).into_response(),
        Err(_) => StatusCode::INTERNAL_SERVER_ERROR.into_response(),
    }
}

pub(crate) async fn health() -> &'static str {
    "ok"
}

pub(crate) async fn live_client() -> Response {
    crate::feluqa::web::live_client()
}

pub(crate) async fn panel_asset(
    crate::axum::extract::Path(asset): crate::axum::extract::Path<String>,
) -> Result<Response, StatusCode> {
    match asset.as_str() {
        "theme.css" => Ok(crate::feluqa::web::panel_stylesheet()),
        "panel.js" => Ok(crate::feluqa::web::panel_client()),
        "echo.js" => Ok(crate::feluqa::web::panel_echo_client()),
        _ => Err(StatusCode::NOT_FOUND),
    }
}
