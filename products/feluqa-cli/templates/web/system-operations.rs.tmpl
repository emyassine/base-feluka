    module_id: String,
    connection: String,
}

fn all_modules() -> Vec<&'static ModuleMigrations> {
    let mut modules = Vec::with_capacity(crate::generated_migrations::ALL.len() + 1);
    modules.push(&CORE_MIGRATIONS);
    modules.extend(crate::generated_migrations::ALL.iter().copied());
    modules
}

async fn migration_rows(pools: &DatabasePools) -> Result<String, ()> {
    let mut rows = Vec::new();
    for module in all_modules() {
        for connection in module.connections {
            let dialect = pools.dialect(connection).ok_or(())?;
            let set = module.for_dialect(dialect).ok_or(())?;
            for (id, status) in MigrationRunner::status(pools, connection, set)
                .await
                .map_err(|_| ())?
            {
                rows.push(format!(
                    "{} · {} · {} · {}",
                    module.module,
                    connection,
                    id,
                    match status {
                        MigrationStatus::Applied => "applied",
                        MigrationStatus::Pending => "pending",
                    }
                ));
            }
        }
    }
    Ok(rows.join("\n"))
}

fn connection_rows(pools: &DatabasePools) -> String {
    pools
        .names()
        .map(|name| {
            format!(
                "{} · {}",
                name,
                pools
                    .dialect(name)
                    .map(dialect_name)
                    .unwrap_or("unknown")
            )
        })
        .collect::<Vec<_>>()
        .join("\n")
}

fn dialect_name(dialect: Dialect) -> &'static str {
    match dialect {
        Dialect::Sqlite => "SQLite",
        Dialect::Postgresql => "PostgreSQL",
    }
}
