pub(crate) async fn dashboard(
    Extension(principal): Extension<Principal>,
    Extension(catalog): Extension<PanelCatalog>,
    Extension(identity): Extension<SessionIdentity>,
    headers: HeaderMap,
) -> Response {
    if !authorized(&principal, "system.dashboard.read") {
        return StatusCode::FORBIDDEN.into_response();
    }
    let Some(csrf) = crate::app::controllers::system::cookie(&headers, "feluqa_csrf") else {
        return StatusCode::UNAUTHORIZED.into_response();
    };
    let navigation = match crate::app::controllers::system::administration::panel_navigation(&catalog, &principal, "/system") { Ok(value) => value, Err(status) => return status.into_response() };
    match crate::views::system_dashboard(&identity.display_name, &identity.email, csrf, navigation, "Feluqa Core") {
        Ok(html) => Html(html).into_response(),
        Err(_) => StatusCode::INTERNAL_SERVER_ERROR.into_response(),
    }
}

pub(crate) async fn modules(
    Extension(principal): Extension<Principal>,
    Extension(catalog): Extension<PanelCatalog>,
    Extension(identity): Extension<SessionIdentity>,
    State(pools): State<DatabasePools>,
    headers: HeaderMap,
) -> Response {
    if !authorized(&principal, "system.modules.read") {
        return StatusCode::FORBIDDEN.into_response();
    }
    let Some(csrf) = crate::app::controllers::system::cookie(&headers, "feluqa_csrf") else { return StatusCode::UNAUTHORIZED.into_response(); };
    let rows = all_modules()
        .iter()
        .map(|module| {
            format!(
                "{} · databases: {} · dialects: {}",
                module.module,
                module.connections.join(", "),
                module
                    .supported_dialects
                    .iter()
                    .map(|dialect| dialect_name(*dialect))
                    .collect::<Vec<_>>()
                    .join(", ")
            )
        })
        .collect::<Vec<_>>()
        .join("\n");
    let connections = connection_rows(&pools);
    match crate::views::system_modules(
        &identity.display_name,
        &identity.email,
        &rows,
        &connections,
        crate::app::controllers::system::administration::panel_navigation(&catalog, &principal, "/system/modules").unwrap_or_else(|_| feluqa::view::TrustedHtml::from_trusted(String::new())),
        "Feluqa Core",
        csrf,
    ) {
        Ok(html) => Html(html).into_response(),
        Err(_) => StatusCode::INTERNAL_SERVER_ERROR.into_response(),
    }
}

