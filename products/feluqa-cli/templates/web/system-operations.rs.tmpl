pub(crate) async fn migrations(
    Extension(principal): Extension<Principal>,
    Extension(catalog): Extension<PanelCatalog>,
    Extension(identity): Extension<SessionIdentity>,
    State(pools): State<DatabasePools>,
    headers: HeaderMap,
) -> Response {
    if !authorized(&principal, "system.migrations.read") {
        return StatusCode::FORBIDDEN.into_response();
    }
    let Some(csrf) = crate::app::controllers::system::cookie(&headers, "feluqa_csrf") else {
        return StatusCode::UNAUTHORIZED.into_response();
    };
    let rows = match migration_rows(&pools).await {
        Ok(rows) => rows,
        Err(_) => return StatusCode::INTERNAL_SERVER_ERROR.into_response(),
    };
    let mut run_actions = String::new();
    if authorized(&principal, "system.migrations.run") {
        for module in all_modules() {
            for connection in module.connections {
                if pools
                    .dialect(connection)
                    .is_none_or(|dialect| module.for_dialect(dialect).is_none())
                {
                    continue;
                }
                run_actions.push_str(&format!(
                    "<form method=\"post\" action=\"/system/migrations\"><input type=\"hidden\" name=\"csrf_token\" value=\"{csrf}\"><input type=\"hidden\" name=\"module_id\" value=\"{}\"><input type=\"hidden\" name=\"connection\" value=\"{}\"><button class=\"btn\" type=\"submit\">Apply pending migrations · {} · {}</button></form>",
                    module.module, connection, module.module, connection
                ));
            }
        }
    }
    let run_actions = feluqa::view::TrustedHtml::from_trusted(run_actions);
    match crate::views::system_migrations(
        &identity.display_name,
        &identity.email,
        &rows,
        run_actions,
        crate::app::controllers::system::administration::panel_navigation(&catalog, &principal, "/system/migrations").unwrap_or_else(|_| feluqa::view::TrustedHtml::from_trusted(String::new())),
        "Feluqa Core",
        csrf,
    ) {
        Ok(html) => Html(html).into_response(),
        Err(_) => StatusCode::INTERNAL_SERVER_ERROR.into_response(),
    }
}

pub(crate) async fn run_migrations(
    Extension(core): Extension<CoreStore>,
    Extension(principal): Extension<Principal>,
    Extension(identity): Extension<SessionIdentity>,
    State(pools): State<DatabasePools>,
    Extension(secure): Extension<bool>,
    headers: HeaderMap,
    Form(form): Form<RunMigrationsForm>,
) -> Response {
    if !authorized(&principal, "system.migrations.run") {
        return StatusCode::FORBIDDEN.into_response();
    }
    if !csrf_valid(&core, &headers, &form.csrf_token, secure).await {
        return StatusCode::FORBIDDEN.into_response();
    }
    let Some(module) = all_modules()
        .into_iter()
        .find(|module| module.module == form.module_id)
    else {
        return StatusCode::BAD_REQUEST.into_response();
    };
    if !module.connections.contains(&form.connection.as_str())
        || pools.dialect(&form.connection).is_none()
    {
        return StatusCode::BAD_REQUEST.into_response();
    }
    if MigrationRunner::run_module(&pools, &form.connection, module)
        .await
        .is_err()
    {
        let _ = core
            .record_audit(
                Some(identity.user_id),
                "system.migrations.run",
                module.module,
                Some(&form.connection),
                "failed",
            )
            .await;
        return StatusCode::INTERNAL_SERVER_ERROR.into_response();
    }
    if core
        .record_audit(
            Some(identity.user_id),
            "system.migrations.run",
            module.module,
            Some(&form.connection),
            "allowed",
        )
        .await
        .is_err()
    {
        return StatusCode::INTERNAL_SERVER_ERROR.into_response();
    }
    Redirect::to("/system/migrations").into_response()
}

pub(crate) async fn audit(
    Extension(principal): Extension<Principal>,
    Extension(catalog): Extension<PanelCatalog>,
    Extension(identity): Extension<SessionIdentity>,
    Extension(pools): Extension<DatabasePools>,
    headers: HeaderMap,
) -> Response {
    if !authorized(&principal, "system.audit.read") {
        return StatusCode::FORBIDDEN.into_response();
    }
    let Some(csrf) = crate::app::controllers::system::cookie(&headers, "feluqa_csrf") else { return StatusCode::UNAUTHORIZED.into_response(); };
    let database = match pools.default_connection() {
        Ok(database) => database,
        Err(_) => return StatusCode::INTERNAL_SERVER_ERROR.into_response(),
    };
    let events = match audit_event::Entity::find()
        .filter(audit_event::Column::TenantId.eq(identity.tenant_id))
        .order_by_desc(audit_event::Column::OccurredAtEpoch)
        .order_by_desc(audit_event::Column::Id)
        .limit(100)
        .all(database)
        .await
    {
        Ok(events) => events,
        Err(_) => return StatusCode::INTERNAL_SERVER_ERROR.into_response(),
    };
    let rows = events
        .iter()
        .map(|event| {
            format!(
                "{} · actor {:?} · {} · {} · record {:?} · {}",
                event.occurred_at_epoch,
                event.actor_user_id,
                event.action,
                event.resource,
                event.record_key,
                event.outcome
            )
        })
        .collect::<Vec<_>>()
        .join("\n");
    match crate::views::system_audit(&identity.display_name, &identity.email, &rows, crate::app::controllers::system::administration::panel_navigation(&catalog, &principal, "/system/audit").unwrap_or_else(|_| feluqa::view::TrustedHtml::from_trusted(String::new())), "Feluqa Core", csrf) {
        Ok(html) => Html(html).into_response(),
        Err(_) => StatusCode::INTERNAL_SERVER_ERROR.into_response(),
    }
}

pub(crate) async fn tenants(
    Extension(core): Extension<CoreStore>,
    Extension(principal): Extension<Principal>,
    Extension(catalog): Extension<PanelCatalog>,
    Extension(identity): Extension<SessionIdentity>,
    headers: HeaderMap,
) -> Response {
    if !authorized(&principal, "system.tenants.read") {
        return StatusCode::FORBIDDEN.into_response();
    }
    let Some(csrf) = crate::app::controllers::system::cookie(&headers, "feluqa_csrf") else {
        return StatusCode::UNAUTHORIZED.into_response();
    };
    let tenants = match core.tenants(identity.user_id).await {
        Ok(tenants) => tenants,
        Err(_) => return StatusCode::FORBIDDEN.into_response(),
    };
    let rows = tenants
        .iter()
        .map(|tenant| {
            format!(
                "#{} · {} · {} · {} · created {}",
                tenant.id,
                tenant.slug,
                tenant.display_name,
                if tenant.is_active { "active" } else { "suspended" },
                tenant.created_at_epoch
            )
        })
        .collect::<Vec<_>>()
        .join("\n");
    let mut tenant_actions = String::new();
    if authorized(&principal, "system.tenants.write") {
        for tenant in tenants
            .iter()
            .filter(|tenant| tenant.id != 1 && tenant.id != identity.tenant_id)
        {
            tenant_actions.push_str(
                "<form method=\"post\" action=\"/system/tenants/status\"><input type=\"hidden\" name=\"csrf_token\" value=\"",
            );
            tenant_actions.push_str(csrf);
            tenant_actions.push_str("\"><input type=\"hidden\" name=\"tenant_id\" value=\"");
            tenant_actions.push_str(&tenant.id.to_string());
            tenant_actions.push_str("\"><button name=\"active\" value=\"");
            tenant_actions.push_str(if tenant.is_active { "false" } else { "true" });
            tenant_actions.push_str("\">");
            tenant_actions.push_str(if tenant.is_active { "Suspend tenant" } else { "Reactivate tenant" });
            tenant_actions.push_str(" #");
            tenant_actions.push_str(&tenant.id.to_string());
            tenant_actions.push_str("</button></form>");
        }
    }
    let tenant_actions = feluqa::view::TrustedHtml::from_trusted(tenant_actions);
    let navigation = match crate::app::controllers::system::administration::panel_navigation(
        &catalog,
        &principal,
        "/system/tenants",
    ) {
        Ok(navigation) => navigation,
        Err(status) => return status.into_response(),
    };
    match crate::views::system_tenants(
        &identity.display_name,
        &identity.email,
        csrf,
        &rows,
        tenant_actions,
        navigation,
        "Feluqa Core",
    ) {
        Ok(html) => Html(html).into_response(),
        Err(_) => StatusCode::INTERNAL_SERVER_ERROR.into_response(),
    }
}

pub(crate) async fn create_tenant(
    Extension(core): Extension<CoreStore>,
    Extension(principal): Extension<Principal>,
    Extension(identity): Extension<SessionIdentity>,
    Extension(secure): Extension<bool>,
    headers: HeaderMap,
    Form(form): Form<CreateTenantForm>,
) -> Response {
    if !authorized(&principal, "system.tenants.write") {
        return StatusCode::FORBIDDEN.into_response();
    }
    if !csrf_valid(&core, &headers, &form.csrf_token, secure).await {
        return StatusCode::FORBIDDEN.into_response();
    }
    match core
        .create_tenant(
            &form.slug,
            &form.display_name,
            &form.owner_name,
            &form.owner_email,
            &form.owner_password,
            identity.user_id,
        )
        .await
    {
        Ok(_) => Redirect::to("/system/tenants").into_response(),
        Err(feluqa::core::service::CoreStoreError::GrantEscalation) => {
            StatusCode::FORBIDDEN.into_response()
        }
        Err(feluqa::core::service::CoreStoreError::InvalidTenant) => {
            StatusCode::BAD_REQUEST.into_response()
        }
        Err(_) => StatusCode::INTERNAL_SERVER_ERROR.into_response(),
    }
}

pub(crate) async fn set_tenant_active(
    Extension(core): Extension<CoreStore>,
    Extension(principal): Extension<Principal>,
    Extension(identity): Extension<SessionIdentity>,
    Extension(secure): Extension<bool>,
    headers: HeaderMap,
    Form(form): Form<SetTenantActiveForm>,
) -> Response {
    if !authorized(&principal, "system.tenants.write") {
        return StatusCode::FORBIDDEN.into_response();
    }
    if !csrf_valid(&core, &headers, &form.csrf_token, secure).await {
        return StatusCode::FORBIDDEN.into_response();
    }
    match core
        .set_tenant_active(form.tenant_id, form.active, identity.user_id)
        .await
    {
        Ok(_) => Redirect::to("/system/tenants").into_response(),
        Err(feluqa::core::service::CoreStoreError::GrantEscalation)
        | Err(feluqa::core::service::CoreStoreError::TenantLifecycleDenied) => {
            StatusCode::FORBIDDEN.into_response()
        }
        Err(feluqa::core::service::CoreStoreError::InvalidTenant) => {
            StatusCode::NOT_FOUND.into_response()
        }
        Err(_) => StatusCode::INTERNAL_SERVER_ERROR.into_response(),
    }
}

