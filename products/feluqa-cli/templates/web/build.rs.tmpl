#![no_implicit_prelude]
#![forbid(unsafe_code)]
#![deny(unused_must_use)]

extern crate feluqa;
extern crate std;
extern crate toml;

use feluqa::view::compiler::Compiler;
use std::boxed::Box;
use std::convert::{From, Into};
use std::env;
use std::error::Error;
use std::format;
use std::matches;
use std::io::{Error as IoError, ErrorKind};
use std::iter::Iterator;
use std::option::Option::Some;
use std::path::{Component, Path, PathBuf};
use std::println;
use std::result::Result;
use std::result::Result::{Err, Ok};

fn main() -> Result<(), Box<dyn Error>> {
    let root = PathBuf::from(env::var("CARGO_MANIFEST_DIR")?);
    configure_service_provider(&root)?;
    let output = PathBuf::from(env::var("OUT_DIR")?);
    let mut compiler = Compiler::new();
    compiler.add_root("app", &root.join("resources/views"))?;
    compiler.add_root("system", Path::new(feluqa::system_panel::VIEW_ROOT))?;
    compiler.add_root("feluqa-panel", Path::new(feluqa::panel::VIEW_ROOT))?;
    compiler.parameters("feluqa-panel::components.shell", "panel: &str, active: &str, navigation: crate::feluqa::view::TrustedHtml")?;
    compiler.component("feluqa-panel::shell", "feluqa-panel::components.shell", &["default"])?;
    compiler.component("feluqa-panel::assets", "feluqa-panel::components.assets", &[])?;
    compiler.parameters("app::pages.home", "title: &str")?;
    compiler.entry("home", "app::pages.home")?;
    compiler.parameters("system::pages.system_setup", "csrf_token: &str, notice: &str")?;
    compiler.entry("system_setup", "system::pages.system_setup")?;
    compiler.parameters("system::pages.system_login", "csrf_token: &str, notice: &str")?;
    compiler.entry("system_login", "system::pages.system_login")?;
    compiler.parameters(
        "system::pages.system_users",
        "display_name: &str, email: &str, csrf_token: &str, user_table: crate::feluqa::view::TrustedHtml, create_form: crate::feluqa::view::TrustedHtml, edit_forms: crate::feluqa::view::TrustedHtml, navigation: crate::feluqa::view::TrustedHtml",
    )?;
    compiler.entry("system_users", "system::pages.system_users")?;
    compiler.parameters(
        "system::pages.system_roles",
        "display_name: &str, email: &str, csrf_token: &str, role_table: crate::feluqa::view::TrustedHtml, create_form: crate::feluqa::view::TrustedHtml, edit_forms: crate::feluqa::view::TrustedHtml, navigation: crate::feluqa::view::TrustedHtml",
    )?;
    compiler.entry("system_roles", "system::pages.system_roles")?;
    compiler.parameters(
        "system::pages.system_modules",
        "display_name: &str, email: &str, rows: &str, connections: &str, navigation: crate::feluqa::view::TrustedHtml",
    )?;
    compiler.entry("system_modules", "system::pages.system_modules")?;
    compiler.parameters(
        "system::pages.system_connections",
        "display_name: &str, email: &str, rows: &str, navigation: crate::feluqa::view::TrustedHtml",
    )?;
    compiler.entry("system_connections", "system::pages.system_connections")?;
    compiler.parameters(
        "system::pages.system_migrations",
        "display_name: &str, email: &str, rows: &str, run_actions: crate::feluqa::view::TrustedHtml, navigation: crate::feluqa::view::TrustedHtml",
    )?;
    compiler.entry("system_migrations", "system::pages.system_migrations")?;
    compiler.parameters(
        "system::pages.system_audit",
        "display_name: &str, email: &str, rows: &str, navigation: crate::feluqa::view::TrustedHtml",
    )?;
    compiler.parameters(
        "system::pages.system_tenants",
        "display_name: &str, email: &str, csrf_token: &str, rows: &str, tenant_actions: crate::feluqa::view::TrustedHtml, navigation: crate::feluqa::view::TrustedHtml",
    )?;
    compiler.entry("system_audit", "system::pages.system_audit")?;
    compiler.entry("system_tenants", "system::pages.system_tenants")?;
    compiler.parameters(
        "system::pages.system_dashboard",
        "display_name: &str, email: &str, csrf_token: &str, navigation: crate::feluqa::view::TrustedHtml",
    )?;
    compiler.entry("system_dashboard", "system::pages.system_dashboard")?;
    let generated = compiler.generate()?;
    for dependency in &generated.dependencies {
        println!("cargo:rerun-if-changed={}", dependency.display());
    }
    generated.write_to(&output.join("views.rs"))?;
    feluqa::database::build_support::generate_migration_registry(
        &root,
        &output.join("migrations.rs"),
    )?;
    println!("cargo:rerun-if-changed=build.rs");
    Ok(())
}

fn configure_service_provider(root: &Path) -> Result<(), Box<dyn Error>> {
    let manifest_path = root.join("feluqa.toml");
    println!("cargo:rerun-if-changed={}", manifest_path.display());
    let manifest: toml::Value = toml::from_str(&std::fs::read_to_string(&manifest_path)?)?;
    let provider = manifest.get("app")
        .and_then(|app| app.get("service_provider"))
        .and_then(toml::Value::as_str)
        .ok_or_else(|| IoError::new(ErrorKind::InvalidData, "feluqa.toml must set app.service_provider to a Rust source path"))?;
    let path = Path::new(provider);
    if path.is_absolute()
        || path.components().any(|part| matches!(part, Component::ParentDir | Component::RootDir | Component::Prefix(_)))
        || path.extension().and_then(|extension| extension.to_str()) != Some("rs")
    {
        return Err(IoError::new(ErrorKind::InvalidInput, "app.service_provider must be a relative .rs path inside the application").into());
    }
    let source = root.join(path);
    if !source.is_file() {
        return Err(format!("service provider source does not exist: {}", source.display()).into());
    }
    println!("cargo:rerun-if-changed={}", source.display());
    println!("cargo:rustc-env=FELUQA_SERVICE_PROVIDER={provider}");
    Ok(())
}
