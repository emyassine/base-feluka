<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Tenants · Feluqa Core</title><link rel="stylesheet" href="/assets/site.css"></head><body><main class="layout"><header><p class="eyebrow">Feluqa Core · Platform</p><h1>Tenants</h1><p>{{ display_name }} · {{ email }}</p></header><section class="card"><h2>Application tenants</h2><pre>{{ rows }}</pre><h3>Tenant access</h3>{!! tenant_actions !!}</section><section class="card"><h2>Create tenant and initial administrator</h2><form method="post" action="/system/tenants"><input type="hidden" name="csrf_token" value="{{ csrf_token }}"><label>Slug <input name="slug" required maxlength="64" pattern="[a-z][a-z0-9-]*"></label><label>Tenant name <input name="display_name" required maxlength="160"></label><label>Administrator name <input name="owner_name" required maxlength="160"></label><label>Administrator email <input name="owner_email" type="email" required maxlength="254"></label><label>Initial password <input name="owner_password" type="password" required minlength="12" maxlength="256"></label><button class="btn" type="submit">Create tenant</button></form></section><nav class="card"><a href="/system">Overview</a> · <a href="/system/users">Users</a> · <a href="/system/roles">Roles</a> · <a href="/system/tenants">Tenants</a> · <a href="/system/modules">Modules</a> · <a href="/system/connections">Connections</a> · <a href="/system/migrations">Migrations</a> · <a href="/system/audit">Audit</a></nav></main></body></html>
